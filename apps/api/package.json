{
  "name": "@gig/api",
  "version": "0.0.0",
  "private": true,
  "description": "Local Gig Marketplace API — NestJS modular monolith (Phase 0 skeleton: health endpoints only)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "migrate": "ts-node --transpile-only src/database/migrate-cli.ts",
    "seed": "ts-node --transpile-only src/database/seed-cli.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@gig/shared": "workspace:*",
    "@nestjs/common": "^11.2.2",
    "@nestjs/core": "^11.2.2",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.2",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
