# ==============================================================================
# Local Gig Marketplace — environment variables
# Copy to .env and fill in values. NEVER commit .env or real secrets.
# Values below are safe local-development defaults matching docker-compose.yml.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
# API binds 0.0.0.0:$PORT (required for containerized/PaaS hosting)
PORT=3000

# --- Database (PostgreSQL + PostGIS) -------------------------------------------
DATABASE_URL=postgresql://gig:gig_dev_password@localhost:5432/gig_dev

# --- Redis (queues, rate limiting) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 1) -------------------------------------------------------------
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_only_change_me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (S3-compatible; MinIO locally) — Phase 5 --------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gig-dev
S3_ACCESS_KEY=minio_local
S3_SECRET_KEY=minio_local_password
S3_REGION=us-east-1

# --- Stripe (TEST MODE keys only in development) — Phase 10 ---------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# From `stripe listen --forward-to localhost:3000/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Provider adapters (dev uses console/stub — no paid services required) ------
# console | twilio (Phase 1)
SMS_PROVIDER=console
# console | smtp | resend (Phase 1)
EMAIL_PROVIDER=console
# stub | google | mapbox (Phase 5; see DECISIONS.md OD-1)
GEOCODER_PROVIDER=stub

# --- Mobile (apps/mobile/.env) ---------------------------------------------------
# Use your machine's LAN IP so a physical device can reach the API
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
