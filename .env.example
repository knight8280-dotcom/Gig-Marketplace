# ==============================================================================
# Local Gig Marketplace — environment variables
# Copy to .env and fill in values. NEVER commit .env or real secrets.
# Values below are safe local-development defaults matching docker-compose.yml.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
# API binds 0.0.0.0:$PORT (required for containerized/PaaS hosting)
PORT=3000

# --- Database (PostgreSQL + PostGIS) -------------------------------------------
DATABASE_URL=postgresql://gig:gig_dev_password@localhost:5432/gig_dev

# --- Redis (queues, rate limiting) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 1) -------------------------------------------------------------
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_only_change_me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (S3-compatible; MinIO locally) — Phase 5 --------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gig-dev
S3_ACCESS_KEY=minio_local
S3_SECRET_KEY=minio_local_password
S3_REGION=us-east-1

# --- Stripe (TEST MODE keys only in development) — Phase 10 ---------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# From `stripe listen --forward-to localhost:3000/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Provider adapters (dev uses console/stub — no paid services required) ------
# console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# console | smtp
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=no-reply@localhost
# nominatim (keyless, pilot volume) | stub
GEOCODER_PROVIDER=nominatim

# --- Files (dev: local disk; prod: swap the storage adapter to S3) ---------------
UPLOADS_DIR=./uploads

# --- Browser clients (CORS allow-list; never a wildcard) -------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Mobile (apps/mobile/.env) ---------------------------------------------------
# Use your machine's LAN IP so a physical device can reach the API
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# Stripe payment sheet on native builds (test-mode key)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Base URL for Stripe Connect onboarding return/refresh redirects
EXPO_PUBLIC_APP_URL=https://example.com
# Demo/pilot fallback location when GPS is unavailable
EXPO_PUBLIC_DEFAULT_LAT=30.2672
EXPO_PUBLIC_DEFAULT_LNG=-97.7431
